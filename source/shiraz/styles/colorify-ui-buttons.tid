title: $:/plugins/kookma/shiraz/styles/colorify-ui-buttons
type: text/vnd.tiddlywiki

\rules only conditional
<%if [[$:/config/Shiraz]getindex[colorify-ui-buttons]match[yes]] %>

/* Tiddler edit toolbar buttons as traffic lights (nikorion: saturated tones of
   the same set as the other buttons, instead of the former pastels) */
.tc-tiddler-controls .tc-image-done-button {fill:#5EB95E;}
.tc-tiddler-controls .tc-image-cancel-button {fill:#F0AD4E;}
/* Delete and trashbin (move to trashbin) buttons, in view and edit modes */
.tc-tiddler-controls .tc-image-delete-button,
.tc-tiddler-controls .tc-image-fa-trash-alt {fill:#DD514C;}
/* These css rules makes page control buttons in beatiful color */
/*page control buttons*/
.tc-page-controls .tc-image-new-button     { fill: #5EB95E; } /*New tiddler button*/
/* Open control pannel; the second selector keeps the colour while the button is
   selected (Control Panel open), over Vanilla's tc-selected rule */
.tc-page-controls .tc-image-options-button,
.tc-page-controls button.tc-selected .tc-image-options-button { fill:#8058A5; }
/* These css rules makes tiddler viewtoolbar buttons in beatiful color */
.tc-tiddler-controls .tc-image-edit-button{fill:#F37B1D}
.tc-tiddler-controls .tc-image-info-button{fill:#0E90D2}

<%endif%>