\procedure alert(type:"primary", src:"", width:"100%", class:"", mode:"block") 
<div data-bs-theme=<<color-scheme>> 
class=`alert alert-$(type)$ $(class)$ $(mode)$` 
style=`width:$(width)$;`>
<$transclude $variable="src" $mode=<<mode>>/>
</div>
\end alert

\procedure alert-leftbar(type:"primary", src:"", width:"100%", class:"", mode:"block") 
<div data-bs-theme=<<color-scheme>> 
class=`alert alert-$(type)$ border-$(type)$ leftbar $(class)$ $(mode)$` 
style=`width:$(width)$;`>
<$transclude $variable="src" $mode=<<mode>>/>
</div>
\end alert-leftbar

