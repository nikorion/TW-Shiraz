tags: $:/tags/Global
title: $:/plugins/kookma/shiraz/procedures/details
type: text/vnd.tiddlywiki

\define details(label:"", src:"", status:"", labelClass:"mb-0 h5 bg-dark text-light", srcClass:"mt-0", class:"alert border-dark p-0")
<details class={{{ [[kk-shiraz-details]] [<__class__>] +[join[ ]] }}} $status$>
	<$let tv-wikilinks="no">
		<summary data-bs-theme=<<color-scheme>> class=<<__labelClass__>> ><<__label__>></summary>
	</$let>
	<div data-bs-theme=<<color-scheme>> class=<<__srcClass__>>>
		<%if [<__src__>has[title]] %>
			<$transclude $tiddler=<<__src__>> $mode="block"/>
		<%else%>
			<$transclude $variable="__src__" $mode="block"/>
		<%endif%>			
	</div>
</details>
\end details

<!---- FAQS using details ---->

\procedure faqs-details(filter, status:"closed", labelClass:"alert alert-secondary py-1 my-2", srcClass:"alert border-secondary py-0")
\function tmpSearchTid()   [[$:/temp/shiraz/qa/search-details]] [<currentTiddler>] +[join[/]]
\function searchTerm()     [<tmpSearchTid>get[text]]

<$keyboard key="escape" actions='<$action-setfield $tiddler=<<tmpSearchTid>> $field="text" $value=""/>'>
<$edit-text tiddler=<<tmpSearchTid>> field=text tag=input default="" placeholder=<<shiraz-lingo-text "Search/InTitles">> class="alert alert-info w-100"/>
</$keyboard>

<$list filter="[subfilter<filter>search:title<searchTerm>]">
<$transclude $variable=details label=<<currentTiddler>>  src=<<currentTiddler>>
			 status=<<status>> labelClass=<<labelClass>> srcClass=<<srcClass>> class=""/>
</$list>

\end faqs-details

