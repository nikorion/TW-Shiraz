checked="$:/plugins/kookma/shiraz/ui/breadcrumbs/storylist">&nbsp;Use `$:/StoryList` for breadcrumbs</$checkbox>

: <$checkbox tiddler="$:/config/Shiraz" index="breadcrumbs-type"
checked="$:/plugins/kookma/shiraz/ui/breadcrumbs/historylist"
default="$:/plugins/kookma/shiraz/ui/breadcrumbs/historylist">&nbsp;Use `$:/HistoryList` for breadcrumbs</$checkbox>

<%endif%>

</dl>