<dl>

: <$checkbox tiddler="$:/config/Shiraz" index="breadcrumbs-enabled"
checked="yes" unchecked="no">&nbsp;Display breadcrumbs</$checkbox>

<%if [[$:/config/Shiraz]getindex[breadcrumbs-enabled]else[yes]match[yes]] %>

