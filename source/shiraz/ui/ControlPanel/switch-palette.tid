title: $:/plugins/kookma/shiraz/ui/ControlPanel/switch-palette
type: text/vnd.tiddlywiki
dark-palette: $:/palettes/Nord
light-palette: $:/palettes/Vanilla

\procedure configTiddler() $:/config/Shiraz

\function f.day() [all[tiddlers+shadows]tag[$:/tags/Palette]] :filter[get[color-scheme]match[light]]
\function f.night() [all[tiddlers+shadows]tag[$:/tags/Palette]] :filter[get[color-scheme]match[dark]]

\procedure selectPalette(title, filter, default, index)
<label class="shiraz-switch-label"><$text text=<<title>>/></label>
<$select tiddler=<<configTiddler>> index=<<index>> default=<<default>>>
<$list filter=<<filter>>>
<option value=<<currentTiddler>>>
<$view field="name"><$view field="title"/></$view>
</option>
</$list>
</$select>
\end selectPalette

<div class="shiraz-switch-palette">

<$transclude $variable="selectPalette" 
	title="Light palette" filter="[f.day[]]"
	default={{!!light-palette}} index="light-palette"/>	

<$transclude $variable="selectPalette" 
	title="Dark palette" filter="[f.night[]]" 
	default={{!!dark-palette}} index="dark-palette"/>
	
<label class="shiraz-switch-label">Reset to default</label><$button> {{$:/core/images/erase}}

<$action-setfield $tiddler=<<configTiddler>> 
	$index="light-palette" $value={{!!light-palette}}/>
	
<$action-setfield $tiddler=<<configTiddler>> 
	$index="dark-palette" $value={{!!dark-palette}}/>	
	
<$action-setfield $tiddler="$:/palette" 
	$field="text" $value={{!!light-palette}}/>
	
</$button>

</div>