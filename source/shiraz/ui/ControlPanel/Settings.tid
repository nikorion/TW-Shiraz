caption: Shiraz
tags: $:/tags/ControlPanel/SettingsTab $:/tags/MoreSideBar
title: $:/plugins/kookma/shiraz/ui/ControlPanel/Settings
type: text/vnd.tiddlywiki

\procedure dynamictables-editortype() $:/config/shiraz/dynamictables/editor-type
\procedure configTiddler() $:/config/Shiraz

<<shiraz-lingo "Settings/Intro">>

---

; <<shiraz-lingo-text "Settings/MoreSidebar/Caption">>

: <$checkbox tiddler="$:/plugins/kookma/shiraz/ui/ControlPanel/Settings"
tag="$:/tags/MoreSideBar">
<<shiraz-lingo "Settings/MoreSidebar/Label">>
</$checkbox>

; <<shiraz-lingo-text "Settings/Options/Caption">>

: <$checkbox tiddler=<<configTiddler>>
index="colorify-ui-buttons" checked="yes">
<<shiraz-lingo "Settings/Options/ColorifyButtons">>
</$checkbox>

: <$checkbox tiddler=<<configTiddler>>
index="view-toolbar-buttons-visibility" checked="yes">
<<shiraz-lingo "Settings/Options/HideToolbar">>
</$checkbox>

: <$checkbox tiddler=<<configTiddler>>
index="colorify-sidebar-active-tab" checked="yes">
<<shiraz-lingo "Settings/Options/ColorifyActiveTab">>
</$checkbox>

; <<shiraz-lingo-text "Settings/Palettes/Caption">>

{{$:/plugins/kookma/shiraz/ui/ControlPanel/switch-palette}}

; <<shiraz-lingo-text "Settings/Breadcrumbs/Caption">>

{{$:/plugins/kookma/shiraz/ui/ControlPanel/breadcrumbs}}

---

; <<shiraz-lingo-text "Settings/Editor/Caption">>

: <$checkbox tiddler=<<dynamictables-editortype>> field="text"
checked="main-editor" unchecked="simple-textarea" default="simple-textarea">
<<shiraz-lingo "Settings/Editor/Main">>
</$checkbox>

: <$checkbox tiddler=<<dynamictables-editortype>> field="text"
checked="simple-textarea" unchecked="main-editor" default="simple-textarea">
<<shiraz-lingo "Settings/Editor/Textarea">>
</$checkbox>
