<$let _lang={{{ [[$:/language]get[text]get[name]else[en-GB]] }}}>
<$transclude $tiddler={{{ [[$:/plugins/kookma/shiraz/language/tables/]addsuffix<_lang>addsuffix[/]addsuffix<title>] }}}>
